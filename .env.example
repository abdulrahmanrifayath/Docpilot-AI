# =============================================================================
# DocPilot AI - Environment Configuration Template (.env.example)
# Copy this file to .env and configure for your local/production environment:
#   cp .env.example .env
# =============================================================================

# -----------------------------------------------------------------------------
# Core Application Settings
# -----------------------------------------------------------------------------
APP_NAME="DocPilot AI"
APP_ENV=production              # development, production, test
DEBUG=false                     # true for development logs, false in production
HOST=0.0.0.0
PORT=8000
API_V1_STR=/api/v1

# -----------------------------------------------------------------------------
# Security & JWT Authentication
# IMPORTANT: Generate a secure 32+ character key for production (e.g. openssl rand -hex 32)
# -----------------------------------------------------------------------------
JWT_SECRET_KEY=change-me-to-a-random-secure-32-byte-secret-key-for-jwt-signing
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=10080     # 7 days

# -----------------------------------------------------------------------------
# CORS Allowed Origins
# JSON array of origins permitted to communicate with backend APIs
# -----------------------------------------------------------------------------
CORS_ORIGINS=["http://localhost:3000", "http://127.0.0.1:3000", "http://localhost:80", "http://localhost"]

# -----------------------------------------------------------------------------
# Database Configuration (PostgreSQL in Docker, SQLite local fallback)
# Default Docker network connection uses service name 'postgres'
# -----------------------------------------------------------------------------
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=docpilot
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://postgres:postgres@postgres:5432/docpilot
# For local SQLite development without Docker, use:
# DATABASE_URL=sqlite+aiosqlite:///./data/docpilot.db

# -----------------------------------------------------------------------------
# AI Provider Settings (Optional at startup; can be configured in UI Settings)
# Supported LLM providers: openai, gemini, anthropic, ollama, custom
# -----------------------------------------------------------------------------
LLM_PROVIDER=openai
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini
LLM_BASE_URL=https://api.openai.com/v1

# Embedding Provider (openai or local)
EMBEDDING_PROVIDER=openai
EMBEDDING_MODEL=text-embedding-3-small

# -----------------------------------------------------------------------------
# Vector Database Configuration
# Options: local (built-in disk index) or qdrant
# -----------------------------------------------------------------------------
VECTOR_STORE_TYPE=local
QDRANT_HOST=qdrant
QDRANT_PORT=6333

# -----------------------------------------------------------------------------
# GitHub Integration (Optional personal access token for higher API rate limits)
# -----------------------------------------------------------------------------
GITHUB_TOKEN=

# -----------------------------------------------------------------------------
# Storage & Upload Limits
# -----------------------------------------------------------------------------
MAX_UPLOAD_SIZE_MB=100
MAX_FILE_SIZE_BYTES=2097152    # 2MB max individual source file parse threshold
