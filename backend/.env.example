# Application Configuration
PROJECT_NAME="DocPilot AI"
ENVIRONMENT="development"
DEBUG=true
API_V1_STR="/api/v1"

# Server
HOST="127.0.0.1"
PORT=8000

# CORS Configuration (comma-separated list of allowed origins or JSON array)
CORS_ORIGINS=["http://localhost:5173", "http://127.0.0.1:5173", "http://localhost:3000"]

# Database Configuration
# Local SQLite default:
DATABASE_URL="sqlite:///./docpilot.db"
# PostgreSQL example:
# DATABASE_URL="postgresql://postgres:password@localhost:5432/docpilot"

# AI Provider Configuration (OpenAI-compatible)
OPENAI_API_KEY=""
OPENAI_BASE_URL="https://api.openai.com/v1"
OPENAI_MODEL="gpt-4o-mini"
EMBEDDING_MODEL="text-embedding-3-small"

# Vector Database
CHROMA_PERSIST_DIRECTORY="./chroma_db"
VECTOR_COLLECTION_PREFIX="docpilot_"
